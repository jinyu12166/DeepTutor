.mine-container {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.mine-header {
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 24rpx;
  background: #fff;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.vip-card {
  background: linear-gradient(135deg, #FFB84D 0%, #F5A623 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vip-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.vip-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.vip-btn {
  padding: 12rpx 28rpx;
  background: #fff;
  color: var(--brand-orange);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-gray);
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
}

.logout-btn {
  margin-top: 48rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
  color: var(--danger);
  font-size: 30rpx;
}

.logout-btn:active {
  background: #FFEBEE;
}
