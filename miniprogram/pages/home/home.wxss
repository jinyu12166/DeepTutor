.home-container {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

/* 顶部问候栏 */
.header-card {
  background: linear-gradient(135deg, #007A44 0%, #006938 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 20rpx;
  background: #fff;
}

.greeting {
  display: flex;
  flex-direction: column;
}

.hello {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.sub-text {
  font-size: 26rpx;
  opacity: 0.85;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.85;
}

/* 核心操作区 */
.action-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  height: 200rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.photo-btn {
  background: linear-gradient(135deg, #FFB84D 0%, #F5A623 100%);
}

.text-btn {
  background: linear-gradient(135deg, #007A44 0%, #006938 100%);
}

.action-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 32rpx;
  font-weight: 500;
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.quick-item:active {
  opacity: 0.7;
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.quick-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* AI 建议 */
.suggestion-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.suggestion-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.suggestion-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 最近记录 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
}

.record-item:active {
  background: #EEF0F2;
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.dot-green { background: var(--success); }
.dot-orange { background: var(--warning); }
.dot-red { background: var(--danger); }

.record-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.record-status {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.empty-hint {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-tertiary);
  font-size: 26rpx;
}
