.photo-container {
  min-height: 100vh;
  background: var(--bg-gray);
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}

.camera-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.camera-placeholder {
  width: 100%;
  height: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  border: 2rpx dashed var(--border-color);
}

.camera-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.camera-tip {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.take-photo-btn {
  width: 80%;
}

.preview-area {
  display: flex;
  flex-direction: column;
}

.preview-image {
  width: 100%;
  height: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.preview-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.preview-actions .btn {
  flex: 1;
}

.supplement-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
}

.supplement-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.supplement-input {
  width: 100%;
  height: 160rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-green);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
