.quiz-container {
  padding: 24rpx;
  padding-bottom: 48rpx;
  min-height: 100vh;
  background: var(--bg-gray);
  box-sizing: border-box;
}

.progress-header {
  margin-bottom: 24rpx;
}

.progress-text {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.progress-track {
  height: 12rpx;
  background: #E8E8E8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-track .progress-fill {
  height: 100%;
  background: var(--brand-green);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: var(--text-secondary);
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--brand-green);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.question-type {
  margin-bottom: 20rpx;
}

.type-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.type-choice { background: #E8F5E9; color: var(--success); }
.type-fill { background: #E3F2FD; color: #2196F3; }
.type-written { background: #FFF3E0; color: var(--warning); }

.question-content {
  display: block;
  font-size: 32rpx;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 32rpx;
}

/* 选择题 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.option-item {
  padding: 24rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
}

.option-item:active {
  background: #EEF0F2;
}

.option-selected {
  border-color: var(--brand-green);
  background: var(--brand-light);
}

.option-correct {
  border-color: var(--success);
  background: #E8F5E9;
}

.option-wrong {
  border-color: var(--danger);
  background: #FFEBEE;
}

/* 填空题 */
.fill-area {
  margin-bottom: 32rpx;
}

.fill-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 解答题 */
.written-area {
  margin-bottom: 32rpx;
}

.written-input {
  width: 100%;
  height: 300rpx;
  background: var(--bg-gray);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 提交 */
.submit-btn {
  margin-bottom: 32rpx;
}

/* 解析 */
.explanation-box {
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.result-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.result-correct { background: #E8F5E9; color: var(--success); }
.result-wrong { background: #FFEBEE; color: var(--danger); }

.explanation-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.explanation-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.next-btn {
  text-align: center;
}
